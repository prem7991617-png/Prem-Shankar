rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can upload media
    match /posts/{userId}/{mediaId} {
      // Must be authenticated and upload to own user directory
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        // Max 10MB for photos, 50MB for videos
        && request.resource.size < 50 * 1024 * 1024
        // Valid image/video types only
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
